# Porta em que o servidor vai rodar
PORT=3000

# Chave HMAC do webhook, gerada na Adyen Customer Area em:
# Developers > Webhooks > (seu webhook) > HMAC Key
# Sem essa chave, o servidor aceita qualquer POST sem verificar assinatura -
# use isso so em testes locais, nunca em producao.
ADYEN_HMAC_KEY=
