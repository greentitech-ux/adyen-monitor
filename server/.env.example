# Porta em que o servidor vai rodar
PORT=3000

# Usuario/senha do dashboard (HTTP Basic Auth) - protege o site inteiro
# (transacoes, disputas, anexos) contra acesso sem login. Sem essas duas
# variaveis preenchidas, o site fica acessivel sem senha - so recomendado
# pra teste local, nunca em producao (o webhook da Adyen continua aberto,
# ele e verificado por assinatura HMAC, nao por essa senha).
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Contas de usuario do app (Master + acessos com permissao limitada), por
# DENTRO do Basic Auth acima - veja server/auth.js. Sem essas 4 variaveis o
# login do app nao funciona.
#
# Chave usada pra assinar os tokens de login (JWT). Gere uma aleatoria forte:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Chave usada pra criptografar (AES-256-GCM) as senhas salvas no Cofre antes
# de irem pro Firestore. Gere do mesmo jeito que o JWT_SECRET, com outro
# valor. ATENCAO: se trocar essa chave depois de ja ter senhas salvas, elas
# ficam ilegiveis (nao ha como decifrar com a chave nova).
ENCRYPTION_KEY=

# Email/senha do seu acesso Master (criado automaticamente na primeira vez
# que o servidor sobe, se ainda nao existir nenhum Master no banco). O Master
# tem acesso total e cria os outros acessos (com permissoes limitadas) pela
# tela de Usuarios.
MASTER_EMAIL=
MASTER_PASSWORD=

# Chaves HMAC do webhook por merchant account, geradas na Adyen Customer Area em:
# Developers > Webhooks > (seu webhook) > HMAC Key
# Formato: {"MinhaContaMerchant": "chavehexaqui", "OutraConta": "outrachave"}
# Sem chave configurada para uma conta, o servidor aceita qualquer POST sem
# verificar assinatura - use isso so em testes locais, nunca em producao.
ADYEN_HMAC_KEYS=

# Chaves VAPID para push notifications (gere com: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seuemail@exemplo.com

# Credenciais do Firebase (Firestore) - usadas para persistir o historico de
# transacoes fora do disco local (necessario em hospedagens com disco efemero,
# como o Render). Gere em: console.firebase.google.com > Configuracoes do
# projeto > Contas de servico > Gerar nova chave privada (baixa um JSON com
# esses 3 campos).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Bucket do Cloud Storage onde ficam as imagens anexadas nas disputas de
# chargeback (comprovante de pedido/retirada). Se nao definir, usamos o bucket
# padrao do Firebase (<FIREBASE_PROJECT_ID>.appspot.com) - so precisa preencher
# se o seu projeto usar um bucket com nome diferente.
FIREBASE_STORAGE_BUCKET=

# Sincronizacao automatica dos Fechamentos com as planilhas do Google Sheets
# (ARCFOOD + Grupo Bravo, aba "BD" por padrao) - ver server/sheetsSync.js.
# Usa a MESMA conta de servico configurada acima (FIREBASE_CLIENT_EMAIL/
# FIREBASE_PRIVATE_KEY), entao pra funcionar:
#   1. Habilite a "Google Sheets API" no mesmo projeto GCP do Firebase, em
#      console.cloud.google.com > APIs e serviços > Ativar APIs e serviços.
#   2. Compartilhe as duas planilhas com o email do FIREBASE_CLIENT_EMAIL
#      (Compartilhar > colar o email > permissão de "Leitor").
# Sem isso, o sistema continua funcionando com o ultimo snapshot conhecido
# (fechamentos-snapshot.json) ate a sincronizacao dar certo.
#
# IDs das planilhas (o trecho da URL entre /d/ e /edit) - opcional, ja tem um
# valor padrao no codigo; so preencha se for usar planilhas diferentes.
SHEET_ID_ARCFOOD=
SHEET_ID_BRAVO=
# Nome da aba com os dados em cada planilha - padrao "BD" nas duas.
SHEET_ABA_ARCFOOD=
SHEET_ABA_BRAVO=
# De quanto em quanto tempo sincronizar automaticamente, em milissegundos -
# padrao 15 minutos (900000). O Master também pode forçar uma sincronização
# na hora pelo botão "Sincronizar agora" em Fechamentos.
SHEETS_SYNC_INTERVAL_MS=

# Integracao de vendas do iFood (Sales API oficial, somente leitura) - ver
# server/ifoodClient.js. Credenciais da aplicacao criada no Portal do
# Desenvolvedor iFood (developer.ifood.com.br), fluxo "aplicacao distribuida"
# (client credentials). Cada loja precisa autorizar essa aplicacao no Portal
# do Parceiro do iFood antes dos dados dela aparecerem na Sales API. Alem
# disso, o mapa merchantId->nome da loja em IFOOD_UNIDADES_NOMES (dentro de
# server/ifoodClient.js) precisa ser preenchido com os merchantId reais.
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=

# De quanto em quanto tempo sincronizar as vendas, em milissegundos. Padrao
# sugerido: 3600000 (1h) - a Sales API e um relatorio financeiro, nao pedidos
# em tempo real; os numeros normalmente so fecham de vez em D+1/D+2.
IFOOD_SYNC_INTERVAL_MS=

# ---------- E-mail (relatorio MV / envio manual da Central) ----------
# Conta remetente + senha de app do Google (SMTP). A senha de app aparece
# no Google em grupos de 4 ("xxxx xxxx xxxx xxxx") - pode colar com ou sem
# espacos, o codigo normaliza.
RELATORIO_EMAIL_USER=
RELATORIO_EMAIL_PASS=
# Destinatario do relatorio diario e das notificacoes instantaneas do MV.
RELATORIO_EMAIL_TO=
# Horario do relatorio diario, formato cron (padrao "0 8 * * *" = 8h Brasilia).
RELATORIO_HORA=

# Envio via API HTTPS do Gmail (porta 443) - OBRIGATORIO em hosts que
# bloqueiam SMTP de saida (o Render bloqueia: timeout na 465 e na 587).
# Com as 3 variaveis abaixo preenchidas, todo envio passa a ir pela API e
# a senha de app (RELATORIO_EMAIL_PASS) deixa de ser usada.
#
# Passo a passo (uma vez so, com a conta do RELATORIO_EMAIL_USER):
#   1. console.cloud.google.com > APIs e servicos > ativar "Gmail API".
#   2. Tela de permissao OAuth (branding): nome do app + email de suporte.
#      Publico: "Interno" se a conta for Workspace (melhor: sem verificacao
#      e o refresh token nao expira). Se so houver "Externo", publique "Em
#      producao" - em modo Teste o refresh token expira em 7 dias.
#   3. Clientes/Credenciais > Criar credenciais > ID do cliente OAuth > tipo
#      "Aplicativo da Web" e adicione em "URIs de redirecionamento
#      autorizados": https://developers.google.com/oauthplayground
#      (tem que ser Web, nao Desktop - senao o playground da
#      redirect_uri_mismatch). Copie o Client ID e o Client Secret.
#   4. developers.google.com/oauthplayground > engrenagem no canto direito >
#      marque "Use your own OAuth credentials" e cole o Client ID/Secret.
#   5. No passo 1 do playground, digite o escopo:
#        https://www.googleapis.com/auth/gmail.send
#      > Authorize APIs > faca login com a conta do RELATORIO_EMAIL_USER.
#   6. No passo 2, clique "Exchange authorization code for tokens" e copie
#      o Refresh token.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
